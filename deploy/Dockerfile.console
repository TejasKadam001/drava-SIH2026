# syntax=docker/dockerfile:1
# Drava operator console (React + Vite) served by nginx.

FROM node:22-alpine AS bundle
WORKDIR /console
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=bundle /console/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
