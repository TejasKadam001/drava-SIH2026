# syntax=docker/dockerfile:1
# Drava inference service: FastAPI + physics models + copilot router.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv/drava

# Compiler toolchain is needed by some scientific wheels.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

COPY twin_api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code, least-volatile directories first.
COPY params/   params/
COPY datasets/ datasets/
COPY wellphysics/ wellphysics/
COPY copilot/   copilot/
COPY twin_api/ twin_api/

WORKDIR /srv/drava/twin_api
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
